{
  "$schema":"https://schema.tauri.app/config/2",
  "productName":"La liste d’Ethan",
  "version":"1.0.0",
  "identifier":"fr.ethan.listecadeaux",
  "build":{
    "frontendDist":"../web"
  },
  "app":{
    "windows":[
      {
        "title":"La liste d’Ethan",
        "width":1200,
        "height":820,
        "minWidth":720,
        "minHeight":640,
        "resizable":true,
        "fullscreen":false
      }
    ],
    "security":{
      "csp":null
    }
  },
  "bundle":{
    "active":true,
    "targets":["nsis","msi"],
    "windows":{
      "nsis":{
        "installMode":"perUser"
      },
      "wix":{
        "language":1036
      }
    }
  }
}