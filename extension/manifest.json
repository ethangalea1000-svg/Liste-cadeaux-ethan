{
  "manifest_version": 3,
  "name": "Mes données — Liste d’Ethan",
  "version": "1.2.0",
  "description": "Enregistre et, avec consentement, transmet à Supabase la télémétrie de la liste d’Ethan. Aucun mot de passe ni code d’accès.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://ckasbsnzxgwfwfnctioe.supabase.co/*"
  ],
  "action": {
    "default_title": "Mes données — Liste d’Ethan",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://ethangalea1000-svg.github.io/Liste-cadeaux-ethan/*"],
      "js": ["site-tracker.js"],
      "run_at": "document_idle"
    }
  ]
}